# Usado só no "npm run dev". Em produção (Vercel) o front chama /api e /ia,
# que o vercel.json redireciona para as APIs no Render — não precisa de variável na Vercel.
VITE_API_URL=https://juntto-java.onrender.com
VITE_API_IA_URL=https://junnto-ia.onrender.com
# API Python (admin e denúncias): deixe vazio enquanto ela não estiver publicada (ex.: http://localhost:5001)
VITE_API_PYTHON_URL=
